#sixuan-recording-overlay{background:transparent;font-family:"Ubuntu Sans","Noto Sans CJK SC",sans-serif;}#sixuan-recording-overlay #recording-card{background:linear-gradient(180deg,{{compat-67}},{{compat-68}});border-radius:{{pill-radius}}px;border:1px solid {{compat-69}};padding:0 10px;box-shadow:inset 0 1px 0 {{compat-70}},inset 0 -1px 0 {{compat-71}},inset 0 10px 18px -12px {{compat-72}},0 14px 34px {{compat-73}},0 0 {{glow-26}}px {{compat-74}};}#sixuan-recording-overlay #recording-card.idle{box-shadow:inset 0 1px 0 {{compat-75}},inset 0 -1px 0 {{compat-76}},inset 0 10px 18px -12px {{compat-77}},0 14px 34px {{compat-78}};}#sixuan-recording-overlay #recording-card.clip{box-shadow:inset 0 1px 0 {{compat-79}},inset 0 -1px 0 {{compat-80}},inset 0 10px 18px -12px {{compat-81}},0 14px 34px {{compat-82}},0 0 {{glow-26}}px {{compat-83}};}#sixuan-recording-overlay #recording-orb{background:linear-gradient(145deg,{{compat-84}},{{compat-85}});border-radius:22px;box-shadow:inset 0 1px 0 {{compat-86}};}#sixuan-recording-overlay #recording-title{color:{{compat-87}};font-size:14px;font-weight:700;letter-spacing:.5px;}#sixuan-recording-overlay #recording-status{color:{{compat-88}};font-size:11.5px;}#sixuan-recording-overlay #recording-card.idle #recording-status{color:{{compat-89}};}#sixuan-recording-overlay #recording-card.clip #recording-status{color:{{compat-90}};}#sixuan-recording-overlay #recording-card.quiet #recording-status{color:{{compat-91}};}#sixuan-recording-overlay #recording-time{font-family:"Ubuntu Sans Mono",monospace;font-size:13px;font-weight:600;color:{{compat-92}};letter-spacing:1px;padding:3px 10px;border-radius:11px;background:{{compat-93}};box-shadow:inset 2px 2px 4px {{compat-94}},inset -1px -1px 2px {{compat-95}};}#sixuan-recording-overlay #recording-help{font-size:10.5px;color:{{compat-96}};}#sixuan-recording-overlay #recording-key{font-size:10px;color:{{compat-97}};padding:1px 6px;border-radius:7px;background:linear-gradient(180deg,{{compat-98}},{{compat-99}});border:1px solid {{compat-100}};box-shadow:0 1px 0 {{compat-101}};}
